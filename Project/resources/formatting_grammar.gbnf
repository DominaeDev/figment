root		::= stub? (dlg | act | narrate | think | ws)+ end?

dlg			::= "<talk=\"" name "\">\"" text "\"</talk>"
act			::= "<act=\"" name "\">*" text "*</act>"
narrate		::= "<narration>" text "</narration>"
think		::= "<think=\"" name "\">" text "</think>"
stub		::= (text "\"</talk>") |
				(text "*</act>") |
				(text "</narrator>") |
				(text ")</think>")

text		::= [^\t\n<>\"*]*
ws			::= [ \t\n]

name		::= ##NAME_PATTERN##
end			::= ( "<|im_end|>" | "</s>" | "<s>" | "<end_of_turn>" | "<EOT>" | "_<EOT>" | "###" | "<｜end▁of▁sentence｜>" )
