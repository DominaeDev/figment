<Scenario>
	<Title>Default scenario</Title>
	<Description>This is a simple scenario of the AI having a conversation with the user.</Description>
	
	<Tags>default, casual</Tags>
	
	<Roles>
		<Role id="ai">
			<Label>AI character</Label>
			<Flags>required</Flags>
			<Brief>{user}'s friend and companion.</Brief>
			<Condition error="Requires a female character">female</Condition>
		</Role>
		
		<Role id="user">
			<Label>User</Label>
			<Flags>required, user</Flags>
			<Brief>{ai}'s best friend.</Brief>
			<Condition error="Requires a male character">male</Condition>
		</Role>
	</Roles>
	
	<Story>
		<Intro>
			<Info>{ai} joined the conversation.</Info>
			<Info>{user} joined the conversation.</Info>
			<Instruct>First, introduce yourself, then greet {user} with a compliment, then suggests a topic for your conversation.</Instruct>
			<InvokeNarrator/>
			<InvokeBot role="ai"/>
		</Intro>
		
		<Outro>
			<Info>The end</Info>
		</Outro>
		
		<Chapters>
			<Chapter id="beginning">		
				<Title>Chapter I</Title>
				<Step>
					<Content>{user} and {ai} are having a casual conversation.</Content>
					
					<Trigger>
						<Condition>story:turn &gt;= 10</Condition>
						<Actions>
							<NextStep/>
						</Actions>
					</Trigger>
				</Step>
			</Chapter>
		</Chapters>
	</Story>
</Scenario>