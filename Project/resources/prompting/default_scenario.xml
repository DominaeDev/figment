<Scenario format="0">
	<Name>Default story</Name>
	<Title>Chat with {ai}</Title>
	<Description>A casual conversation between the AI and the user.</Description>
	<Tags>default, casual</Tags>
	
	<Roles>
		<Role id="ai">
			<Label>Character (AI)</Label>
			<Flags>required</Flags>
			<Brief>{user}'s friend and companion.</Brief>
		</Role>
		
		<Role id="user">
			<Label>User (You)</Label>
			<Flags>required, user</Flags>
			<Brief>{ai}'s best friend.</Brief>
		</Role>
	</Roles>
	
	<Scenes>
		<Scene id="38ee20eb-71d9-4d85-a616-7154a9191faa">
			<Name>Introduction</Name>
			<Content>{user} and {ai} are having a casual conversation.</Content>
			<Events>
				<Event type="info">{ai} joined the conversation.</Event>
				<Event type="info">{user} joined the conversation.</Event>
				<Event type="instruct">First, introduce yourself, then greet {user} with a compliment, then suggests a topic for your conversation.</Event>
				<Event type="instigate" role="narrator"/>
				<Event type="instigate" role="ai"/>
			</Events>
			
			<Triggers>
				<Trigger>
					<Condition>story:turn &gt;= 10</Condition>
					<Actions>
						<Action type="goto-next"/>
					</Actions>
				</Trigger>
			</Triggers>
		</Scene>
	</Scenes>
</Scenario>