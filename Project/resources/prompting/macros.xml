<Macros>
	<!-- Character aliases -->
	<Alias id="char">current:name</Alias>
	<Alias id="character">current:name</Alias>
	<Alias id="character:">current:name</Alias>
	<Alias id="char:">current</Alias>
	<Alias id="char1:">bot1</Alias>
	<Alias id="char2:">bot2</Alias>
	<Alias id="char3:">bot3</Alias>
	<Alias id="char4:">bot4</Alias>
	<Alias id="char5:">bot5</Alias>
	<Alias id="char6:">bot6</Alias>
	<Alias id="char7:">bot7</Alias>
	<Alias id="char8:">bot8</Alias>
	<Alias id="c:">current</Alias>
	<Alias id="user">user:name</Alias>
	<Alias id="u:">user</Alias>
	
	<!-- Standard conditions -->
	<Condition id="single_chat">__num_bots eq 1</Condition>
	<Condition id="group_chat">__num_bots gt 1</Condition>
	<Condition id="is_male">male or gender eq male</Condition>
	<Condition id="is_female">female or gender eq female</Condition>
	<Condition id="is_futa">futanari or shemale or newhalf or hermaphrodite or gender = herm or gender = futa</Condition>
	<Condition id="is_non_binary">non-binary or nonbinary or trans or transsexual or transgender or gender eq none or gender eq asexual</Condition>

	<!-- Pronouns -->
	<Condition id="presumed_masculine">is_male</Condition>
	<Condition id="presumed_feminine">is_female or is_futa</Condition>
	<Condition id="presumed_non_binary">is_non_binary or not (presumed_masculine or presumed_feminine)</Condition>
	<Condition id="m_pronouns">__masculine_pronouns or (not (__feminine_pronouns or __non_binary_pronouns) and presumed_masculine)</Condition>
	<Condition id="f_pronouns">__feminine_pronouns or (not (__masculine_pronouns or __non_binary_pronouns) and presumed_feminine)</Condition>
	<Condition id="nb_pronouns">__non_binary_pronouns or (not (__masculine_pronouns or __feminine_pronouns) and presumed_non_binary)</Condition>
	<Condition id="nt_pronouns">__neuter_pronouns</Condition>
	<Condition id="c_pronouns">custom_they or custom_them or custom_their or custom_theirs or custom_themselves</Condition>
	<Condition id="pl_pronouns">nb_pronouns</Condition>

	<Macro id="they">{custom_they?{custom_they}|{f_pronouns?she|{m_pronouns?he|{nt_pronouns?it|they}}}}</Macro>
	<Macro id="them">{custom_them?{custom_them}|{f_pronouns?her|{m_pronouns?him|{nt_pronouns?it|them}}}}</Macro>
	<Macro id="their">{custom_their?{custom_their}|{f_pronouns?her|{m_pronouns?his|{nt_pronouns?its|their}}}}</Macro>
	<Macro id="theirs">{custom_theirs?{custom_theirs}|{f_pronouns?hers|{m_pronouns?his|{nt_pronouns?its|theirs}}}}</Macro>
	<Macro id="themselves">{custom_themselves?{custom_themselves}|{f_pronouns?herself|{m_pronouns?himself|{nt_pronouns?itself|themselves}}}}</Macro>

	<!-- Grammar macros -->
	<Macro id="is">{pl_pronouns?are|is}</Macro>						<!-- {they} {is} -->
	<Macro id="isn't">{pl_pronouns?aren't|isn't}</Macro>			<!-- {they} {isn't} -->
	<Macro id="are">{pl_pronouns?are|is}</Macro>					<!-- {they} {are} -->
	<Macro id="aren't">{pl_pronouns?aren't|isn't}</Macro>			<!-- {they} {aren't} -->
	<Macro id="was">{pl_pronouns?were|was}</Macro>					<!-- {they} {was} -->
	<Macro id="wasn't">{pl_pronouns?weren't|wasn't}</Macro>			<!-- {they} {wasn't} -->
	<Macro id="were">{pl_pronouns?were|was}</Macro>					<!-- {they} {were} -->
	<Macro id="weren't">{pl_pronouns?weren't|wasn't}</Macro>		<!-- {they} {weren't} -->
	<Macro id="has">{pl_pronouns?have|has}</Macro>					<!-- {they} {has} -->
	<Macro id="hasn't">{pl_pronouns?haven't|hasn't}</Macro>			<!-- {they} {hasn't} -->
	<Macro id="have">{pl_pronouns?have|has}</Macro>					<!-- {they} {have} -->
	<Macro id="haven't">{pl_pronouns?haven't|hasn't}</Macro>		<!-- {they} {haven't} -->
	<Macro id="s">{not pl_pronouns?s}</Macro>						<!-- {they} like{s} -->
	<Macro id="es">{not pl_pronouns?es}</Macro>						<!-- {they} possess{es} -->
	<Macro id="y">{pl_pronouns?y|ies}</Macro>						<!-- {they} tr{y} -->
	<Macro id="ies">{pl_pronouns?y|ies}</Macro>						<!-- {they} tr{ies} -->
	<Macro id="does">{pl_pronouns?do|does}</Macro>					<!-- {they} {does} -->
	<Macro id="does not">{pl_pronouns?do|does} not</Macro>			<!-- {they} {does not} -->
	<Macro id="doesn't">{pl_pronouns?don't|doesn't}</Macro>			<!-- {they} {doesn't} -->
	<Macro id="do">{pl_pronouns?do|does}</Macro>					<!-- {they} {do} -->
	<Macro id="do not">{pl_pronouns?do|does} not</Macro>			<!-- {they} {do not} -->
	<Macro id="don't">{pl_pronouns?don't|doesn't}</Macro>			<!-- {they} {don't} -->
	<Macro id="they've">{they}{pl_pronouns?'ve|'s}</Macro>			<!-- {they've} made pancakes -->
	<Macro id="they're">{they}{pl_pronouns?'re|'s}</Macro>			<!-- {they're} happier still -->
	<Macro id="they'd">{they}'d</Macro>								<!-- {they'd} rather leave -->

</Macros>