root	::= stub? (dlg | act | narrate | ws)+ end?
continue-root	::= cont (dlg | act | narrate | ws)+ end?

dlg			::= "<talk=\"" name "\">\"" text "\"</talk>"
act			::= "<act=\"" name "\">*" text "*</act>"
narrate		::= "<narrator>[" text "]</narrator>"
stub		::= ("\"" text "\"</talk>") |
				("*" text "*</act>") |
				("[" text "]</narrator>")
cont		::= text ("\"</talk>" | "*</act>" | "]</narrator>")

text		::= [^\t<>"*]*
ws			::= [ \n]

name		::= ##NAME_PATTERN##
end			::= ( "<|im_end|>" | "</s>" | "<s>" | "<end_of_turn>" | "<EOT>" | "_<EOT>" | "###" | "<｜end▁of▁sentence｜>" )
