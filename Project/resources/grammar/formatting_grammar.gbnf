root			::= any{1,3} ##STATE## end?
more 			::= any{0,2} ##STATE## end?

# Stubs
stub-talk		::= "\"" [^"*<|>@\n]* "\"</talk>" more
stub-act		::= "*" [^"*<|>@\n]* "*</act>" more
stub-narr		::= "[" [^"*<|>@\]]* "]</narrator>" more

# Continuations
cont-talk		::= [^"*<|>@\n]* "\"</talk>" more
cont-act		::= [^"*<|>@\n]* "*</act>" more
cont-narr		::= [^"*<|>\]]* "]</narrator>" more

# Message types
dlg			::= "<talk=\"" name "\">\"" text "\"</talk>"
act			::= "<act=\"" name "\">*" text "*</act>"
narr		::= "<narrator>[" text "]</narrator>"
any			::= (dlg | act | narr | ws)

# State variables
stat		::= ("<change>" (var-expr | "None") "</change>")*
var-expr	::= var-name " = " var-value
var-name 	::= ##STATE_VARS##
var-value 	::= [^\n\t<>|=,.;@"*(){}[\]]+

text		::= [^\t<|>@"*\]]*
ws			::= [ \n]
name		::= ##NAMES##
end			::= ( "<|im_end|>" | "</s>" | "<s>" | "<end_of_turn>" | "<EOT>" | "_<EOT>" | "###" | "<｜end▁of▁sentence｜>" )