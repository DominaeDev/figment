root			::= any+ end?
more 			::= any* end?

# Stubs
stub-talk		::= "\"" [^"*]* "\"</talk>" more
stub-act		::= "*" [^"*]* "*</act>" more
stub-narr		::= "[" [^"*\]]* "]</narrator>" more

# Continuations
cont-talk		::= [^"*<\n]* "\"</talk>" more
cont-act		::= [^"*<\n]* "*</act>" more
cont-narr		::= [^"*<\n\]]* "]</narrator>" more

# Message types
dlg			::= "<talk=\"" name "\">\"" text "\"</talk>"
act			::= "<act=\"" name "\">*" text "*</act>"
narr		::= "<narrator>[" text "]</narrator>"
any			::= (dlg | act | narr | ws)

text		::= [^\t<>"*\]]*
ws			::= [ \n]
name		::= ##NAME_PATTERN##
end			::= ( "<|im_end|>" | "</s>" | "<s>" | "<end_of_turn>" | "<EOT>" | "_<EOT>" | "###" | "<｜end▁of▁sentence｜>" )