{{default?
# Default root
root ::= any{1,3}{{enable-state? stat}} end?
}}

# Stubs
{{stub?
{{talk?root ::= "\"" [^"*<|>@\n]* "\"</talk>" more}}
{{act?root ::= "*" [^"*<|>@\n]* "*</act>" more}}
{{narrate?root ::= "[" [^"*<|>@\]]* "]</narrator>" more}}}}

# Continuations
{{continue?
{{talk?root ::= [^"*<|>@\n]* "\"</talk>" more}}
{{act?root ::= [^"*<|>@\n]* "*</act>" more}}
{{narrate?root ::= [^"*<|>\]]* "]</narrator>" more}}
}}

# State variables
{{enable-state?
stat		::= ("<change>" (var-expr | "None") "</change>")*
var-expr	::= var-name " = " var-value
var-name 	::= {{_STATE_VARS_}}
var-value 	::= [^\n\t<>|=,.;@"*(){}[\]]+
}}

# Message types
dlg ::= "<talk=\"" name "\">\"" text "\"</talk>"
act ::= "<act=\"" name "\">*" text "*</act>"
narr ::= "<narrator>[" text "]</narrator>"
any ::= (dlg | act{{enable-narrator? | narr}} | ws)

text ::= [^\t<|>@"*\]]*
ws ::= [ \n]
name ::= {{_NAMES_}}
more ::= any{0,2}{{enable-state? stat}} end?
end ::= ( "<|im_end|>" | "</s>" | "<s>" | "<end_of_turn>" | "<EOT>" | "_<EOT>" | "###" | "<｜end▁of▁sentence｜>" )